# ── Base de datos ─────────────────────────────────────────────
# Postgres de producción (Neon, Supabase, Vercel Postgres…).
# Sin esta variable, en local se usa PGlite en .data/ (cero configuración).
DATABASE_URL=

# ── Autenticación (Better Auth) ───────────────────────────────
# Obligatoria en producción. Generala con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública del sitio (en Vercel se detecta sola si no la definís).
BETTER_AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# ── Emails transaccionales (Resend) ───────────────────────────
# Sin API key, los emails (ej. verificación) se imprimen en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM="Homie <no-responder@tudominio.com>"
